{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!docs", "!package-lock.json"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": { "noNonNullAssertion": "off" }
    }
  },
  "overrides": [
    {
      "includes": ["src/**", "!src/main/index.ts", "!src/preload/index.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "electron": "Electron is imported only by src/main/index.ts and src/preload/index.ts (TDD §3); everything else takes what it needs by injection, so it runs under vitest."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/renderer/**", "src/preload/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/core/**", "**/main/**", "**/worker/**", "**/cli/**"],
                    "message": "The renderer is UI only (TDD §3): it talks to main through window.api and takes its types from src/shared, never from the engine or the main process."
                  },
                  {
                    "group": ["node:*", "fs", "path", "os", "child_process", "worker_threads"],
                    "message": "The renderer is sandboxed (TDD §3): no Node built-ins."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "electron": "src/core is pure TypeScript (TDD §16): no Electron.",
                  "sql.js": "src/core receives sql.js as an injected instance (TDD §16); import types only."
                },
                "patterns": [
                  {
                    "group": ["node:*", "fs", "path", "os", "child_process", "worker_threads"],
                    "message": "src/core is pure TypeScript (TDD §16): no Node built-ins."
                  },
                  {
                    "group": [
                      "**/main/**",
                      "**/renderer/**",
                      "**/preload/**",
                      "**/worker/**",
                      "**/cli/**"
                    ],
                    "message": "src/core must not import from the app layers (TDD §16)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
